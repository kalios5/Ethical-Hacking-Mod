#
# my.cnf  -  MySQL server configuration for the ICT2212 vulnerable e-commerce SaaS
# -----------------------------------------------------------------------------
# Owned by the DB-container member.  This file is mounted read-only into the
# MySQL container (see docker-compose).  Its job is:
#   1. Make the DB reachable by the Flask app container over the docker network.
#   2. Turn on SERVER-SIDE LOGGING so both the defender (us) and the attacking
#      teams have logs to inspect / cover their tracks in.
#
# NOTE: everything under /var/log/mysql is written to a folder that is bind
# mounted to ./deployment/db/logs on the host, so the Docker-Escape PoC and the
# blue-team both have a real "logs folder" to work with.
# -----------------------------------------------------------------------------

[mysqld]

# --- Networking -------------------------------------------------------------
# Listen on all interfaces inside the container network. The container is NOT
# published to the public internet directly - only the app talks to it over the
# private docker network. (The tech-stack diagram shows the DB behind the app.)
bind-address              = 0.0.0.0
port                      = 3306

# --- Character set -----------------------------------------------------------
character-set-server      = utf8mb4
collation-server          = utf8mb4_unicode_ci

# --- Error log ---------------------------------------------------------------
# Startup / crash / warning messages.
log-error                 = /var/log/mysql/error.log

# --- General query log -------------------------------------------------------
# Logs EVERY statement the server receives (connect, query, quit).
# This is the single most useful log for a security lab: when an attacker does
# "DB Console Access -> Dump Hashed Account Details" it shows up here as the
# SELECT against the users table. It is verbose and normally OFF in production,
# but for the defender demo (footprinting/enumeration of our OWN server) we
# want it ON so we can prove detection, and so attackers have tracks to cover.
general-log               = 1
general-log-file          = /var/log/mysql/general.log

# --- Slow query log ----------------------------------------------------------
# Any statement slower than long_query_time seconds is recorded. Handy for
# spotting UNION-based / blind SQLi that hammers the DB.
slow-query-log            = 1
slow-query-log-file       = /var/log/mysql/slow.log
long-query-time           = 2
log-queries-not-using-indexes = 1

# --- Binary log (statement level) -------------------------------------------
# Records every data-CHANGING statement (INSERT/UPDATE/DELETE). Gives a
# tamper-evident trail of what was modified - useful evidence for the R1/R2
# reports. STATEMENT format keeps the raw SQL readable in the log.
server-id                 = 1
log-bin                   = /var/log/mysql/binlog
binlog-format             = STATEMENT
max-binlog-size           = 50M
# Keep 7 days of binlogs so the volume does not fill the small EC2 disk.
binlog-expire-logs-seconds = 604800

# --- Timestamps in the local timezone so logs line up with app.log ----------
log-timestamps            = SYSTEM

[client]
default-character-set     = utf8mb4
