# -----------------------------------------------------------------------------
# .env.example  -  copy to .env and fill in.  DO NOT commit the real .env.
# -----------------------------------------------------------------------------
# Flask
SECRET_KEY=change-me-to-a-random-string

# MySQL (used by both the db container and the app container)
DB_ROOT_PASSWORD=rootpass_change_me
DB_NAME=eh_shop
DB_USERNAME=eh_app
DB_PASSWORD=app_change_me
DB_HOST=db          # the service name in docker-compose == the DB hostname
DB_PORT=3306

# --- LAB VULNERABILITY TOGGLE (team decision, see DB_SETUP_GUIDE.md) ----------
# How stored passwords are hashed.  For the "easy web hack" (dump DB -> crack
# hashes) the attackers need a crackable scheme.
#   secure  = salted PBKDF2 via werkzeug (blue-team / hardened default)
#   weak    = unsalted SHA-256 (crackable with a wordlist - use for the demo)
#   md5     = unsalted MD5 (very crackable - easiest tier)
PASSWORD_HASH_MODE=weak
